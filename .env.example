# --- agentrouter (primary, OpenAI style, multi-key failover) ---
AGENT_ROUTER_API_KEY=key1,key2,key3
AGENTROUTER_KEY_COOLDOWN=60s
# AGENTROUTER_TARGET=https://agentrouter.org

# --- opencode (free models only, OpenAI style) ---
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen

# --- alibabacloud (qwen + kimi only, OpenAI style) ---
ALIBABA_API_KEY=your-alibaba-api-key
ALIBABA_BASE_URL=https://your-region.maas.aliyuncs.com/compatible-mode

# --- freemodel.dev (fallback for agentrouter) ---
FREEMODEL_API_KEY=key1,key2
FREEMODEL_API_BASE_URL=https://api.freemodel.dev
FREEMODEL_CC_BASE_URL=https://cc.freemodel.dev

# --- aerolink (fallback for Claude models, Anthropic style, multi-key) ---
AEROLINK_API_KEY=key1,key2
AEROLINK_BASE_URL=https://capi.aerolink.lat

# --- forge gateway (OpenAI style) ---
FORGE_API_KEY=key1,key2
FORGE_BASE_URL=https://forge-gateway-api.fly.dev

# --- server ---
AGENTROUTER_PORT=1765
