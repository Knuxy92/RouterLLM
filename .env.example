# Required by routerllm.yaml.example (agentrouter provider) — an unset value is a fatal config error.
AGENT_ROUTER_API_KEY=your-agent-router-api-key

# OpenCode needs no API key: `routerllm --opencode-login` creates
# opencode-accounts.json (override with OPENCODE_ACCOUNTS_FILE). The device
# flow talks to https://opencode.ai/console (override with OPENCODE_CONSOLE_URL).
# opencode_auth: anonymous|bolt additionally requires OPENCODE_TLS_RELAY=1 —
# the gateway only accepts anonymous traffic over the Bun TLS relay.

# Kilo Code needs no API key: `routerllm --kilo-login` creates
# kilo-accounts.json (override with KILO_ACCOUNTS_FILE). The device flow talks
# to https://api.kilo.ai (KILO_API_URL); the gateway defaults to
# https://ai-gateway.kilo.ai/api (KILO_AI_GATEWAY_URL).
KILO_API_URL=https://api.kilo.ai
KILO_AI_GATEWAY_URL=https://ai-gateway.kilo.ai/api
# KILO_ACCOUNTS_FILE=

ALIBABA_API_KEY=your-alibaba-api-key

FREEMODEL_API_KEY=key1,key2

AEROLINK_API_KEY=key1,key2

FORGE_API_KEY=key1,key2

# Google AI Studio key for `style: google` (Gemini) providers
GEMINI_API_KEY=your-gemini-api-key

ROUTERLLM_DEBUG=true
ROUTERLLM_DEBUG_ADVANCED=false
# # Request-event telemetry (admin console logs/charts). Empty = jsonl beside the
# config; set an absolute/relative path to relocate the file.
ROUTERLLM_TELEMETRY_FILE=
# Set to "off" to stop injecting stream_options.include_usage on OpenAI-style streams.
ROUTERLLM_TELEMETRY_USAGE=on
ROUTERLLM_LOG_FILE=routerllm.log  # uncomment for file logging outside Docker

# Admin API + embedded vanilla-JS console (unset = admin endpoints return 403)
ROUTERLLM_ADMIN_TOKEN=

# Bearer token for /v1 write endpoints (POST chat/responses/messages, file uploads).
# Comma-separated for multiple tokens. GET endpoints (/v1/models, downloads) stay open.
# Unset = /v1 accepts anyone.
AUTHTOKEN=

# HTTPS for the admin console on a dedicated port (unset = plain HTTP on the main port).
# A self-signed cert is generated automatically at admin-tls.crt/.key beside the config,
# or point both paths at your own certificate.
# ROUTERLLM_ADMIN_TLS_PORT=1766
# ROUTERLLM_ADMIN_TLS_CERT=
# ROUTERLLM_ADMIN_TLS_KEY=

# OpenCode TLS relay: route style:opencode providers through a local Bun child
# so the gateway's transport-level client gate sees Bun's TLS fingerprint
# (required from datacenter IPs; residential IPs pass any client). Needs bun
# on PATH unless OPENCODE_RELAY_BIN is set. Relay failure falls back to the
# provider's direct base_url. See internal/relay/README.md.
# OPENCODE_TLS_RELAY=1
# OPENCODE_RELAY_PORT=9999
# OPENCODE_RELAY_BIN=
# OPENCODE_RELAY_UPSTREAM=
# Representative-tool mode: collapse a client's whole tool surface (e.g. every
# MCP server it runs) into a text catalog in the system prompt plus ONE
# `execute` tool with JSON arguments {"tool", "arguments"}. The gateway's
# structural gate flags requests whose tools[] does not look like the real
# CLI's; the representative pack (execute + the required edit/read/shell/write)
# passes. Responses map each execute call back to the client's native tool
# name, so any OpenAI-compatible client works unchanged. Chat dialect only.
# Clients that already speak Code Mode (their own execute tool) pass through.
# See internal/services/rep_tools_README.md for the full contract and troubleshooting.
# OPENCODE_REP_TOOLS=1
