# Required by routerllm.yaml.example (agentrouter provider) — an unset value is a fatal config error.
AGENT_ROUTER_API_KEY=your-agent-router-api-key

OPENCODE_API_KEY=your-opencode-api-key

ALIBABA_API_KEY=your-alibaba-api-key

FREEMODEL_API_KEY=key1,key2

AEROLINK_API_KEY=key1,key2

FORGE_API_KEY=key1,key2

# Google AI Studio key for `style: google` (Gemini) providers
GEMINI_API_KEY=your-gemini-api-key

ROUTERLLM_DEBUG=true
ROUTERLLM_DEBUG_ADVANCED=false
# # Request-event telemetry (admin console logs/charts). Empty = jsonl beside the
# config; set an absolute/relative path to relocate the file.
ROUTERLLM_TELEMETRY_FILE=
# Set to "off" to stop injecting stream_options.include_usage on OpenAI-style streams.
ROUTERLLM_TELEMETRY_USAGE=on
ROUTERLLM_LOG_FILE=routerllm.log  # uncomment for file logging outside Docker

# Admin API + embedded vanilla-JS console (unset = admin endpoints return 403)
ROUTERLLM_ADMIN_TOKEN=

# Bearer token for /v1 write endpoints (POST chat/responses/messages, file uploads).
# Comma-separated for multiple tokens. GET endpoints (/v1/models, downloads) stay open.
# Unset = /v1 accepts anyone.
AUTHTOKEN=

# HTTPS for the admin console on a dedicated port (unset = plain HTTP on the main port).
# A self-signed cert is generated automatically at admin-tls.crt/.key beside the config,
# or point both paths at your own certificate.
# ROUTERLLM_ADMIN_TLS_PORT=1766
# ROUTERLLM_ADMIN_TLS_CERT=
# ROUTERLLM_ADMIN_TLS_KEY=
